# PhishShield Environment Configuration Example
# Copy this file to .env and replace placeholders before deployment.

# Flask Application Settings
FLASK_ENV=development
FLASK_DEBUG=0
PORT=5000

# Session & Security Secret (Required in production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# SQLite Database Location (defaults to local instance directory)
DATABASE_URL=sqlite:///instance/phishshield.db

# Allowed Frontend Origins (CORS & SameSite cookie validation)
FRONTEND_URL=http://localhost:5173
